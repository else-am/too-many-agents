#!/usr/bin/env python3
"""Build the plugin and bundle its runtime files for installation from the mod JAR."""
import json
import hashlib
import os
from pathlib import Path
import plistlib
import shutil
import subprocess
import sys
import zipfile

ROOT = Path(__file__).resolve().parents[1]
PLUGIN = ROOT / 'bb-plugin'


def build_environment():
    env = dict(os.environ)
    # Finder does not inherit the terminal's Homebrew/user PATH.
    if sys.platform == 'darwin':
        env['PATH'] = os.pathsep.join([env.get('PATH', ''), '/opt/homebrew/bin',
                                     '/usr/local/bin', str(Path.home() / '.local/bin')])
    return env


def bb_command(env):
    executable = env.get('BB_CLI') or shutil.which('bb', path=env.get('PATH'))
    candidates = [Path(executable)] if executable else []
    if not executable and sys.platform == 'darwin':
        candidates += [Path('/Applications/BB.app'), Path.home() / 'Applications/BB.app']
    for candidate in candidates:
        path = candidate.resolve()
        app = next((parent for parent in [path, *path.parents] if parent.suffix == '.app'), None)
        if app and (app / 'Contents/Info.plist').is_file():
            script = app / 'Contents/Resources/app.asar.unpacked/node_modules/bb-app/host-daemon/dist/bb'
            with (app / 'Contents/Info.plist').open('rb') as source:
                binary = plistlib.load(source)['CFBundleExecutable']
            runtime = app / 'Contents/MacOS' / binary
            if script.is_file() and runtime.is_file():
                # Use BB's bundled runtime without opening another desktop app.
                env.pop('BB_CLI', None)
                env['ELECTRON_RUN_AS_NODE'] = '1'
                return [str(runtime), str(script)]
        elif path.is_file():
            return [str(path)]
    raise RuntimeError('Could not find the installed BB CLI. Install BB in Applications, add bb to PATH, or set BB_CLI.')


def main():
    # BB validates tool instructions when loading, after its bundle has built.
    # Catch this limit here so a valid build cannot ship an unloadable plugin.
    instructions = (PLUGIN / 'surface/scripting.md').read_text()
    if len(instructions.encode('utf-16-le')) // 2 > 4096:
        raise RuntimeError("Minecraft scripting instructions exceed BB's 4096-character limit.")
    env = build_environment()
    bb_env = dict(env)
    bb = bb_command(bb_env)
    npm = env.get('TOO_MANY_AGENTS_NPM') or shutil.which('npm', path=env.get('PATH'))
    if not npm:
        raise RuntimeError('Building the plugin requires Node.js and npm. Add npm to PATH or set TOO_MANY_AGENTS_NPM.')
    # Source edits need a build, not a fresh dependency installation.
    dependencies = hashlib.sha256((PLUGIN / 'package.json').read_bytes() + (PLUGIN / 'package-lock.json').read_bytes()).hexdigest()
    installed = PLUGIN / 'node_modules/.too-many-agents-dependencies'
    if not installed.is_file() or installed.read_text() != dependencies or not (PLUGIN / 'node_modules/.package-lock.json').is_file():
        subprocess.run([npm, 'ci', '--prefix', str(PLUGIN), '--ignore-scripts', '--no-audit', '--no-fund'], env=env, check=True)
        installed.write_text(dependencies)
    shutil.copyfile(ROOT / 'surface/tools.json', PLUGIN / 'surface/tools.json')
    subprocess.run([npm, '--prefix', str(PLUGIN), 'run', 'typecheck'], env=env, check=True)
    subprocess.run([npm, '--prefix', str(PLUGIN), 'run', 'build:scripting'], env=env, check=True)
    subprocess.run([*bb, 'plugin', 'build', str(PLUGIN)], env=bb_env, check=True)
    # Frontend installation scans the package. Avoid shipping accidentally
    # expanded multi-version data as an enormous JavaScript source file.
    if (PLUGIN / 'dist/server.js').stat().st_size > 32 * 1024 * 1024:
        raise RuntimeError('Plugin server bundle exceeds 32 MiB; inspect bundled data/dependencies.')
    # The diagram worker runs independently of BB's server bundle. Include its
    # pure-JavaScript dependencies and WASM; installation needs neither npm nor a compiler.
    packages = subprocess.check_output([npm, 'ls', '--omit=dev', '--all', '--parseable'], cwd=PLUGIN, env=env, text=True).splitlines()
    manifest = json.loads((PLUGIN / 'package.json').read_text())
    manifest['bb']['server'] = './server.js'
    manifest.pop('devDependencies', None)
    manifest.pop('scripts', None)
    files = {'package.json': (json.dumps(manifest, indent=2) + '\n').encode(),
             'server.js': (PLUGIN / 'dist/server.js').read_bytes()}
    if manifest['bb'].get('app'):
        # BB rebuilds frontends on local-path installation, even with a prebuilt
        # bundle. These sources use only its shared runtime and local CSS.
        for name in ['app.tsx', 'app.css', 'sidebar-dock.ts', 'world-workspace.ts']:
            files[name] = (PLUGIN / name).read_bytes()
        for name in ['app.js', 'app.css', 'app.meta.json']:
            files['dist/' + name] = (PLUGIN / 'dist' / name).read_bytes()
    for item in ['skills', 'surface', 'assets', 'diagram-worker.mjs', 'scripting', 'dist/scripting']:
        path = PLUGIN / item
        for source in sorted(path.rglob('*')) if path.is_dir() else [path]:
            if source.is_file():
                files[source.relative_to(PLUGIN).as_posix()] = source.read_bytes()
    for package in packages:
        directory = Path(package)
        if directory == PLUGIN:
            continue
        for source in sorted(directory.rglob('*')):
            if source.is_file() and 'node_modules' not in source.relative_to(directory).parts:
                files[source.relative_to(PLUGIN).as_posix()] = source.read_bytes()
    output = ROOT / 'build/bb-plugin.zip'
    output.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(output, 'w', compression=zipfile.ZIP_DEFLATED) as archive:
        for name, content in sorted(files.items()):
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            archive.writestr(info, content)
    print('Bundled Minecraft plugin ' + manifest['version'])


if __name__ == '__main__':
    main()
