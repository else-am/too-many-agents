#!/usr/bin/env python3
"""Build our BB plugin and install it into your running BB, or reload it if already installed."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
PLUGIN = ROOT / 'bb-plugin'
APP = Path('/Applications/BB.app/Contents')
APP_CLI = APP / 'Resources/app.asar.unpacked/node_modules/bb-app/dist/bb.js'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--bb-cli', help='Installed bb CLI executable; otherwise use PATH or the installed macOS app')
    args = parser.parse_args()
    env = dict(os.environ)
    env['PATH'] = str(Path.home() / '.local/bin') + os.pathsep + env.get('PATH', '')
    if args.bb_cli:
        executable = shutil.which(args.bb_cli, path=env['PATH'])
        if not executable:
            parser.error('--bb-cli must name an installed executable')
        command = [executable]
    elif executable := shutil.which('bb', path=env['PATH']):
        command = [executable]
    elif APP_CLI.is_file() and (APP / 'MacOS/bb').is_file():
        command = [str(APP / 'MacOS/bb'), str(APP_CLI)]
        env['ELECTRON_RUN_AS_NODE'] = '1'
    else:
        raise RuntimeError('BB CLI not found. Use your installed bb on PATH or pass --bb-cli /path/to/bb.')

    def cli(*values):
        result = subprocess.run([*command, *values], cwd=ROOT, env=env, text=True, capture_output=True)
        if result.returncode:
            # Native output can contain credentials; never forward it through this workflow.
            raise RuntimeError(f'`bb {" ".join(values)}` failed; inspect it directly in BB.')
        return result.stdout

    npm = os.environ.get('TOO_MANY_AGENTS_NPM', 'npm')
    if not (PLUGIN / 'node_modules/@get-bb/plugin-sdk/package.json').is_file():
        subprocess.run([npm, 'ci', '--prefix', str(PLUGIN), '--ignore-scripts', '--no-audit', '--no-fund'], cwd=ROOT, check=True)
    # BB loads the plugin from this folder; physical tool schemas are shared with Java.
    shutil.copyfile(ROOT / 'surface/tools.json', PLUGIN / 'surface/tools.json')
    subprocess.run([npm, '--prefix', str(PLUGIN), 'run', 'typecheck'], cwd=ROOT, check=True)
    cli('plugin', 'build', str(PLUGIN))

    installed = next((row for row in json.loads(cli('plugin', 'list', '--json'))['plugins'] if row['id'] == 'minecraft'), None)
    if installed and installed.get('rootDir') != str(PLUGIN):
        raise RuntimeError('BB already has a Minecraft plugin from another source; remove it in BB first.')
    if installed:
        cli('plugin', 'reload', 'minecraft', '--json')
    elif not json.loads(cli('plugin', 'install', 'path:' + str(PLUGIN), '--yes', '--json')).get('ok'):
        raise RuntimeError('BB did not accept the Minecraft plugin.')
    print('Minecraft plugin ' + ('reloaded' if installed else 'installed') + ' in BB. Running games reconnect by themselves.')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.CalledProcessError) as error:
        print('BB plugin: ' + str(error), file=sys.stderr)
        sys.exit(1)
